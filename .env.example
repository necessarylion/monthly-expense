# Compose-level overrides (copy to .env and fill in)
HOST_PORT=3333
# exactly 32 characters. Signs MCP sessions; keep it the same across deploys.
APP_KEY=replace_me_with_random_32_chars
APP_URL=http://localhost:3333
LOG_LEVEL=info
FRONTEND_URLS=http://localhost:3333

# Firebase Admin (backend) — service-account JSON values
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK (baked into the SPA bundle at build time)
VITE_API_URL=/api/v1
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
