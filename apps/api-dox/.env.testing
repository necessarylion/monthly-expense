# Read by `dart test` after .env. A real env variable wins, so CI can run
# the same tests on Postgres: DATABASE_URL=postgres://... dart test
APP_ENV=testing
APP_KEY=test-only-key-0123456789abcdef!!
APP_URL=http://localhost:3333
DB_PATH=storage/test.sqlite3
PUBLIC_DIR=test/fixtures/public
CACHE_DIR=storage/test-cache
FRONTEND_URLS=http://localhost:5173
ALLOWED_EMAILS=
