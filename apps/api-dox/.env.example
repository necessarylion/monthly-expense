# Copy to .env for local runs. Production sets these in Coolify.
APP_ENV=development
# exactly 32 characters, `dox key:generate`. Required in production.
APP_KEY=
PORT=3333
HOST=0.0.0.0
APP_URL=http://localhost:3333
# isolates (threads) of the server. Empty: one per CPU core.
APP_TOTAL_ISOLATE=

# SQLite by default. Set DATABASE_URL=postgres://... to use Postgres.
DB_PATH=./storage/db.sqlite3
DATABASE_URL=

PUBLIC_DIR=./public
CACHE_DIR=./storage/cache
FRONTEND_URLS=http://localhost:5173
ALLOWED_EMAILS=

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase Web SDK config. /config.js sends it to the browser.
FIREBASE_API_KEY=
# empty: <FIREBASE_PROJECT_ID>.firebaseapp.com
FIREBASE_AUTH_DOMAIN=
FIREBASE_APP_ID=

# Claude API key. Picks expense categories from the note, and cleans up the
# quick-add list. Empty: no AI (new notes get no category, plain list).
ANTHROPIC_API_KEY=
# empty: claude-opus-5-5. claude-haiku-5-5 is cheaper.
ANTHROPIC_MODEL=
